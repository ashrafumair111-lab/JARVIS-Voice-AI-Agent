# LiveKit Cloud (https://cloud.livekit.io -> project -> Settings -> API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (https://console.groq.com/keys) - the LLM brain
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# Deepgram (https://console.deepgram.com) - speech to text
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxx
DEEPGRAM_MODEL=nova-3

# Cartesia (https://play.cartesia.ai/keys) - text to speech
CARTESIA_API_KEY=xxxxxxxxxxxxxxxx
CARTESIA_MODEL=sonic-3
# Voice id for "Ronald" - swap for any voice from https://play.cartesia.ai/voices
CARTESIA_VOICE=5ee9feff-1265-424a-9d7f-8e4d431a12c7
# Optional: emotion + speed (float, e.g. 0.94; leave empty for defaults)
CARTESIA_EMOTION=Confident
CARTESIA_SPEED=

# Tavily (https://tavily.com) - web search tool
TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# Qdrant + Cohere (semantic memory)
QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=xxxxxxxxxxxxxxxx
COHERE_API_KEY=xxxxxxxxxxxxxxxx

# MongoDB Atlas (conversation history + command audit log)
MONGO_URL=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/